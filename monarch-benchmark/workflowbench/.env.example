# Copy to .env (gitignored). `wb` loads it automatically. API-key billing only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FIREWORKS_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=
# Control-arm effort for claude-opus-4-8 (Monarch's authoring brain runs xhigh).
WB_ANTHROPIC_EFFORT=xhigh

# Optional shared configuration source. Leave unset for legacy local files.
# WB_CONFIG_REPOSITORY=TestBoxLab/ailabls-benchmark-config
# WB_CONFIG_GITHUB_TOKEN=  # Repository-scoped token; Contents read/write for Studio saves.
# WB_CONFIG_CACHE=       # Optional persistent directory for immutable CLI revisions.
