      ],
      "threads": [
       {
        "id": "1478113248",
        "thread_type": "customer",
        "body": "I need custom fields for contacts. Couldn't find instructions in docs.",
        "author_email": "admin@growthco.com",
        "created_at": "2026-08-14T00:00:00"
       },
       {
        "id": "6554073867",
        "thread_type": "reply",
        "body": "Here's how to set up custom fields:\n\n1. Navigate to Settings > Data Model > Custom Fields\n2. Click 'Add Custom Field'\n3. Choose field type (Text, Number, Date, Dropdown)\n4. Set name and optional description\n5. Under 'Visibility', choose which roles can see/edit\n6. For dropdowns, add options in 'Values'\n7. Click Save\n\nNeeds Admin permissions. This should be in our docs.",
        "author_email": "agent@support.com",
        "created_at": "2026-08-14T00:00:00"
       }
      ],
      "created_at": "2026-08-14T00:00:00",
      "updated_at": "2026-08-14T00:00:00"
     },
