      "name": "inbox_id",
      "in": "path",
      "required": true,
      "description": "Identifier of the target inbox.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "description": "Number of results per page (10\u00e2\u20ac\u201c100, default 10).",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "sort_by",
      "in": "query",
      "required": false,
      "description": "Field used to order the results.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "sort_order",
      "in": "query",
      "required": false,
      "description": "Direction of sorting: 'asc' or 'desc' (default 'asc').",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "next_page",
      "in": "query",
      "required": false,
      "description": "Token used to retrieve the next page of results.",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "{data: {results: [Conversation], pagination: {next_page: string|null}}}",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/inboxes/{inbox_id}/conversations/{conversation_id}": {
   "get": {
    "operationId": "hiver.conversations.get",
    "summary": "Fetch a single Hiver conversation using its ID.",
    "description": "Fetch a single Hiver conversation using its ID.",
    "parameters": [
     {
      "name": "inbox_id",
      "in": "path",
      "required": true,
      "description": "Identifier of the inbox.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "conversation_id",
      "in": "path",
      "required": true,
      "description": "Identifier of the conversation.",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "{data: {results: [Conversation], pagination: {next_page: null}}}",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   },
   "patch": {
    "operationId": "hiver.conversations.update",
    "summary": "Modify a Hiver conversation. Update its assignee, status, or associated tags.",
    "description": "Modify a Hiver conversation. Update its assignee, status, or associated tags.",
    "parameters": [
     {
      "name": "inbox_id",
      "in": "path",
      "required": true,
      "description": "Identifier of the inbox.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "conversation_id",
      "in": "path",
      "required": true,
      "description": "Identifier of the conversation.",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "{data: {results: [Conversation], pagination: {next_page: null}}}",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    },
    "requestBody": {
     "description": "Body: {status (optional, object \u00e2\u20ac\u201d {name: 'open'|'closed'|'pending'}), assignee (optional, object \u00e2\u20ac\u201d {email: string}), tags (optional, object \u00e2\u20ac\u201d {to_apply: [string], to_remove: [string]})}",
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object"
       }
      }
     }
    }
