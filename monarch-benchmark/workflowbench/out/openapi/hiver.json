 "components": {
  "schemas": {
   "Conversation": {
    "type": "object",
    "description": "A Hiver email thread housed within a shared inbox.",
    "properties": {
     "id": {
      "type": "string",
      "description": "Unique identifier for the conversation."
     },
     "assignee": {
      "type": "object",
      "properties": {
       "assignee_type": {
        "type": "string",
        "enum": [
         "user"
        ]
       },
       "assignee_id": {
        "type": "string"
       }
      }
     },
     "status": {
      "type": "string",
      "enum": [
       "open",
       "closed",
       "pending"
      ]
     },
     "tag_ids": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Collection of tag identifiers linked to this conversation."
     }
    }
   },
   "Inbox": {
    "type": "object",
    "description": "A Hiver collaborative shared inbox.",
    "properties": {
     "id": {
      "type": "string"
     },
     "display_name": {
      "type": "string"
     },
     "channel_type": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "inbox_type": {
      "type": "string"
     },
     "is_authorised": {
      "type": "boolean"
     },
     "created_at": {
      "type": "integer"
     },
     "updated_at": {
      "type": "integer"
     }
    }
   },
   "User": {
    "type": "object",
    "description": "A Hiver agent or user account.",
    "properties": {
     "id": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "display_name": {
      "type": "string"
     }
    }
   }
  }
 }
}