       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     {
      "name": "maxResults",
      "in": "query",
      "required": false,
      "description": "Upper limit on messages to return (default 100, max 500).",
      "schema": {
       "type": "integer"
      }
     },
